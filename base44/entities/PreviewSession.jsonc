{
  "name": "PreviewSession",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "description": "Unguessable token in the temporary preview address"
    },
    "project_id": {
      "type": "string",
      "description": "Project the address serves, read-only"
    },
    "expires_at": {
      "type": "string",
      "description": "ISO timestamp when the address stops working"
    }
  },
  "required": [
    "token",
    "project_id",
    "expires_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Project title, renameable from the workspace"
    },
    "summary": {
      "type": "string",
      "description": "First prompt, kept as the project summary"
    },
    "provider": {
      "type": "string",
      "description": "Provider that answered the last turn"
    },
    "model": {
      "type": "string",
      "description": "Model that answered the last turn"
    },
    "file_count": {
      "type": "number",
      "default": 0
    },
    "message_count": {
      "type": "number",
      "default": 0
    },
    "last_activity": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
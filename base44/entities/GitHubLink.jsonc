{
  "name": "GitHubLink",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "App user this GitHub connection belongs to"
    },
    "login": {
      "type": "string",
      "description": "GitHub account login, shown in the workspace"
    },
    "token": {
      "type": "string",
      "description": "Personal access token. Read on the server only; the member owns the row."
    }
  },
  "required": [
    "user_id",
    "token"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
